// Cloudflare deploy config: serves the dashboard as static files, plus src/worker.js for
// Sign in with TikTok (/auth/*, /api/*). The KV namespace is created on the first deploy.
{
  "name": "ai-smm-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "." },
  "kv_namespaces": [{ "binding": "HQ" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  // The TikTok client key is public (it appears in the login link); the client secret is a Worker secret.
  "vars": { "ACCESS_TEAM": "snowy-forest-7c54.cloudflareaccess.com", "TIKTOK_CLIENT_KEY": "sbawo3ktwxiv6bgd85" }
}
